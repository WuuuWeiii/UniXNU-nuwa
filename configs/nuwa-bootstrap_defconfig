# Bootstrap pass: build the base 4 KiB XNU and a prelinked candidate with no
# device archives. This produces the compile records under build/xnu/ and the
# prelinked original-class candidate (kernel.macho) the device archives build
# against (build-ufs-original-bindings.py reads it as its --candidate).
#
# CONFIG_XNU_BUILD_ARCHIVES is deliberately unset, so the unixnu driver skips the
# board.toml archive list for this pass. CRYPTO_BOOTSTRAP=prelinked uses the
# kernelcache's prelinked corecrypto, so the pass links without
# build-corecrypto-14.py. Every force-loaded archive provider is off.

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_SOURCE_CORECRYPTO14=n
CONFIG_XNU_SOURCE_PTHREAD=n
CONFIG_XNU_ARM_DT_PLATFORM=n
CONFIG_XNU_ARMCPU=n
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_AES=n
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n
CONFIG_XNU_VERIFIED_ROOT_PROBE=n
CONFIG_XNU_OWNER_ROOT_AUDIT=n
CONFIG_XNU_OWNER_ROOT_TRUST=n
CONFIG_XNU_NATIVE_CS_HASH_CACHE=n
CONFIG_XNU_SHENG_PMGR=n
CONFIG_XNU_OWNER_CACHE_MOUNT=n
CONFIG_XNU_OWNER_CACHE_STARTUP=n
CONFIG_XNU_OWNER_BOOT_MANIFEST=n
CONFIG_XNU_OWNER_DATA_MOUNT=n
CONFIG_XNU_OWNER_UNION_SYSTEMOS=n
CONFIG_XNU_DT_PANIC_REGION=n
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_NATIVE_ARCH_TIMER=n
CONFIG_XNU_NATIVE_PAN=n
CONFIG_XNU_BOOT_PROGRESS=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n

# Xcode 16's clang removed -Wunnecessary-virtual-specifier; with -Werror an unknown
# -Wno-* is fatal, so override the script default instead of patching it.
CONFIG_XNU_EXTRA_CFLAGS="-Wno-reserved-identifier -Wno-pre-c11-compat -Wno-missing-designated-field-initializers -Wno-suggest-override -Wno-suggest-destructor-override -Wno-ms-bitfield-padding -Wno-unknown-warning-option"
