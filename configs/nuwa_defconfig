# Kernel configuration of the nuwa image. CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.
#
# 这是"可复现 full 边界"：一切只靠 pinned 源码 + pinned kernelcache 就能编出来的都打开，
# 需要真机/目标卷 DMG 才能产出的验证门（storage ABI 快照、verified-root 策略包、VirtIO/RamBlock、
# owner-root、boot progress、Adreno）全部关闭 —— 对齐 uke 的 uke-full_defconfig 分层。
# 等真机验证通过、拿到 live storage 快照与签名策略包后，再逐项打开（nuwa-full-plus）。
#
# CONFIG_XNU_BUILD_ARCHIVES=y 让 unixnu 驱动在最终链接前跑 board.toml 的 archives 列表；
# bootstrap_defconfig 不设它，所以 bootstrap pass 不跑 archives、只产出 prelink candidate。

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_SHENG_PMGR=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y

# 硬件验证门，全部关闭（真机/目标卷 DMG 才能产出的输入）：
#   NATIVE_VIRTIO_BLOCK / NATIVE_RAM_BLOCK
#       build/storage-abi/interface-audit.json 需要 live guest 快照 (gdb-stop.json)。
#   VERIFIED_ROOT_PROBE / OWNER_ROOT_AUDIT / OWNER_ROOT_TRUST
#       需要从真实 OS/SystemOS DMG 生成的签名策略包。
#   OWNER_CACHE_* / OWNER_BOOT_MANIFEST / OWNER_DATA_MOUNT / OWNER_UNION_SYSTEMOS
#       依赖 owner-root trust 路径。
#   BOOT_PROGRESS
#       基础构建在缺少 audited UFS/owner-root、VirtIO 与 source-crypto 时拒绝它。
#   NATIVE_ADRENO
#       驱动目前只认识 Adreno 740 的常量和固件，nuwa 的 GPU 电源/固件尚未采集。
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n
CONFIG_XNU_VERIFIED_ROOT_PROBE=n
CONFIG_XNU_OWNER_ROOT_AUDIT=n
CONFIG_XNU_OWNER_ROOT_TRUST=n
CONFIG_XNU_OWNER_CACHE_MOUNT=n
CONFIG_XNU_OWNER_CACHE_STARTUP=n
CONFIG_XNU_OWNER_BOOT_MANIFEST=n
CONFIG_XNU_OWNER_DATA_MOUNT=n
CONFIG_XNU_OWNER_UNION_SYSTEMOS=n
CONFIG_XNU_BOOT_PROGRESS=n
CONFIG_XNU_NATIVE_ADRENO=n

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_EXTRA_LD_ARCHIVES=""
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n

# Xcode 16's clang removed -Wunnecessary-virtual-specifier; with -Werror an unknown
# -Wno-* is fatal, so override the script default instead of patching it.
CONFIG_XNU_EXTRA_CFLAGS="-Wno-reserved-identifier -Wno-pre-c11-compat -Wno-missing-designated-field-initializers -Wno-suggest-override -Wno-suggest-destructor-override -Wno-ms-bitfield-padding -Wno-unknown-warning-option"
