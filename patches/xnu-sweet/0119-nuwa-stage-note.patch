diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -20,6 +20,23 @@
 static unsigned int early_row, early_col;
 static unsigned int early_started, early_disabled, early_panicking;
 
+/*
+ * The bars on the panel are not durable evidence: fbcon paints the whole
+ * screen once it comes up, and a crashed boot is followed by UniXNU redrawing
+ * the menu, so the bars are gone by the time anyone looks. Record the same
+ * picture as a bitmask in DRAM instead, at an offset inside the kernel window
+ * that the kernel itself never reaches (it needs about 21 MiB of the 304 MiB
+ * DarwinBoot hands it), not the first 16 MiB, which is inside the kernel image
+ * itself. DarwinBoot always places the window at 0x8c0004000
+ * on this device, and the mapping is VA=PA while arm_init runs, so a plain
+ * physical store works. The boot manager reads it back on the next start.
+ */
+#define EARLY_NOTE_BASE   0x8d3003000ULL
+#define EARLY_NOTE_MAGIC  0x4e4f5445ULL /* 'ETON' */
+#define EARLY_NOTE_STAGES 8u             /* arm_init stages 1..7 fit here */
+
+static volatile uint64_t *early_note = (volatile uint64_t *)(uintptr_t)EARLY_NOTE_BASE;
+
 static void
 sweet_early_clear_row(void)
 {
@@ -89,6 +105,14 @@ sweet_early_mark(unsigned int stage, const char *label)
 	if (early_disabled || stage > 20) {
 		return;
 	}
+	if ((stage >= 1) && (stage < EARLY_NOTE_STAGES)) {
+		if (early_note[0] != EARLY_NOTE_MAGIC) {
+			early_note[0] = EARLY_NOTE_MAGIC;
+			early_note[1] = 0;
+		}
+		early_note[1] |= (1ULL << stage);
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
 	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
 	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
 		for (unsigned int x = stage * 48; x < (stage + 1) * 48; x++) {
