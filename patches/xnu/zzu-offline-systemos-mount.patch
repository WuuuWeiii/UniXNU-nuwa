+extern "C" int
+IOFillMediaDevice(const char *wanted_uuid, dev_t *device, char *path, size_t size)
+{
+	OSDictionary *matching = IOService::serviceMatching("IOMedia");
+	OSDictionary *properties;
+	OSString *uuid, *name;
+	IOService *service;
+	mach_timespec_t timeout;
+	timeout.tv_sec = 30;
+	timeout.tv_nsec = 0;
+	int found = 0;
+
+	if (!matching || !path || size < 16) {
+		if (matching) {
+			matching->release();
+		}
+		return 0;
+	}
+	properties = OSDictionary::withCapacity(1);
+	uuid = OSString::withCString(wanted_uuid);
+	if (properties && uuid) {
+		properties->setObject("UUID", uuid);
+		matching->setObject(kIOPropertyMatchKey, properties);
+	}
+	if (uuid) {
+		uuid->release();
+	}
+	if (properties) {
+		properties->release();
+	}
+	service = IOService::waitForService(matching, &timeout);
+	if (service && (name = OSDynamicCast(OSString, service->getProperty(kIOBSDNameKey)))) {
+		OSNumber *major = OSDynamicCast(OSNumber, service->getProperty("BSD Major"));
+		OSNumber *minor = OSDynamicCast(OSNumber, service->getProperty("BSD Minor"));
+		if (device && major && minor) {
+			*device = makedev(major->unsigned32BitValue(), minor->unsigned32BitValue());
+			strlcpy(path, "/dev/", size);
+			strlcat(path, name->getCStringNoCopy(), size);
+			found = 1;
+		}
+	}
+	/*
+	 * waitForService() consumes the matching dictionary (IOFindBSDRoot retains it before the
+	 * call for exactly this reason), so it must not be released again here.
+	 */
+	return found;
+}
