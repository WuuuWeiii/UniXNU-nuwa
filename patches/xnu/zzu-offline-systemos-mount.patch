+/*
+ * Offline SystemOS mount. The dyld shared cache of a real iOS root lives on the SystemOS
+ * (Cryptex) volume, not on the OS volume, and the unmodified dyld only looks under
+ * /System/Library/Caches/com.apple.dyld. Mount that volume read-only on /System/Cryptexes/OS
+ * and hand launchd a DYLD_SHARED_CACHE_DIR that points into it. Development instrument: gated
+ * by the offline-systemos-mount boot argument, run once, and it never touches the root mount.
+ */
+extern int IOFillMediaDevice(const char *uuid, dev_t *device, char *path, size_t size);
+extern int bdevvp(dev_t dev, vnode_t *vpp);
+extern struct vfstable *vfsconf;
+extern errno_t vfs_rootmountalloc(const char *fstypename, const char *devname, mount_t *mpp);
+extern int mount_list_add(mount_t mp);
+extern errno_t vfs_init_io_attributes(vnode_t devvp, mount_t mp);
+extern void name_cache_lock(void);
+extern void name_cache_unlock(void);
+extern uint32_t mount_generation;
+
+user_addr_t offline_init_envp = USER_ADDR_NULL;
+static boolean_t offline_systemos_done = FALSE;
+
+static int
+offline_systemos_mount(proc_t p, user_addr_t scratch_addr, user_addr_t *envp)
+{
+	static const char environment[] =
+	    "DYLD_SHARED_CACHE_DIR=/System/Cryptexes/OS/System/Library/Caches/com.apple.dyld";
+	static const char mountpoint[] = "/System/Cryptexes/OS";
+	static const char systemos_uuid[] = "96096B28-B6DC-4BC7-9D3A-2632A0FE53F1";
+	char argument[8];
+	char device_path[64];
+	dev_t device;
+	vnode_t devvp = NULLVP;
+	vnode_t mntvp = NULLVP;
+	mount_t mp = NULL;
+	user64_addr_t environment_vector[2];
+	int error;
+
+	if (offline_systemos_done) {
+		return 0;
+	}
+	if (!PE_parse_boot_argn("offline-systemos-mount", argument, sizeof(argument))) {
+		offline_systemos_done = TRUE;
+		return 0;
+	}
+	if (!IOFillMediaDevice(systemos_uuid, &device, device_path, sizeof(device_path))) {
+		panic("offline SystemOS: no IOMedia with UUID %s", systemos_uuid);
+	}
+	/*
+	 * There is no devfs node for this media: IOKit starts before devfs is mounted, so
+	 * IOMediaBSDClient never created one. bdevvp() builds the block device vnode straight
+	 * from the dev_t, exactly as vfs_mountroot() does for the root, and APFS reads the
+	 * volume through that vnode instead of through a spec path.
+	 */
+	if ((error = bdevvp(device, &devvp)) != 0) {
+		panic("offline SystemOS: bdevvp(%s) failed: %d", device_path, error);
+	}
+	if ((error = vnode_lookup(mountpoint, 0, &mntvp, vfs_context_kernel())) != 0) {
+		panic("offline SystemOS: lookup %s failed: %d", mountpoint, error);
+	}
+	if ((error = vfs_rootmountalloc("apfs", "systemos", &mp)) != 0) {
+		panic("offline SystemOS: vfs_rootmountalloc failed: %d", error);
+	}
+	mp->mnt_flag &= ~MNT_ROOTFS;
+	mp->mnt_devvp = devvp;
+	strlcpy(mp->mnt_vfsstat.f_mntonname, mountpoint, MAXPATHLEN);
+	if ((error = VFS_MOUNT(mp, devvp, 0, vfs_context_kernel())) != 0) {
+		panic("offline SystemOS: VFS_MOUNT failed: %d", error);
+	}
+	/* vfs_syscalls.c place_mount_and_checkdirs() is static; plant the same state here. */
+	mp->mnt_vnodecovered = mntvp;
+	vnode_lock_spin(mntvp);
+	mntvp->v_mountedhere = mp;
+	SET(mntvp->v_flag, VMOUNTEDHERE);
+	wakeup(&mntvp->v_flag);
+	vnode_unlock(mntvp);
+	(void)vnode_ref(mntvp);
+	name_cache_lock();
+	mount_generation++;
+	name_cache_unlock();
+	(void)mount_list_add(mp);
+	vfs_unbusy(mp);
+	(void)vfs_init_io_attributes(devvp, mp);
+	environment_vector[0] = scratch_addr + 0x400;
+	environment_vector[1] = USER_ADDR_NULL;
+	if ((error = copyout(environment, environment_vector[0], sizeof(environment))) != 0 ||
+	    (error = copyout(environment_vector, scratch_addr + 0x500,
+	    sizeof(environment_vector))) != 0) {
+		panic("offline SystemOS: env copyout failed: %d", error);
+	}
+	*envp = scratch_addr + 0x500;
+	offline_systemos_done = TRUE;
+	printf("offline SystemOS: %s mounted on %s via bdevvp\n", device_path, mountpoint);
+	return 0;
+}
