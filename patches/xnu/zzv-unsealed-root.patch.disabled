diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index 94243c9..b7ffe68 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1095,7 +1095,16 @@ bsd_init(void)
 			}
 #endif
 			if (autherr && !owner_authorized) {
-				panic("rootvp not authenticated after mounting");
+				/*
+				 * A kernel booted without iBoot has no chain of trust to extend, so a
+				 * non-Apple root (or a self-made volume) can never satisfy the seal check.
+				 * Report it instead of panicking when the boot arguments ask for it.
+				 */
+				if (PE_parse_boot_argn("unsealed-root", NULL, 0)) {
+					printf("BSD root: root volume is not authenticated (error %d); continuing unsealed\n", autherr);
+				} else {
+					panic("rootvp not authenticated after mounting");
+				}
 			}
 #if defined(XNU_OWNER_ROOT_TRUST) && XNU_OWNER_ROOT_TRUST
 			{
