diff --git a/bsd/kern/native_console_log.c b/bsd/kern/native_console_log.c
new file mode 100644
index 0000000..e607c65
--- /dev/null
+++ b/bsd/kern/native_console_log.c
@@ -0,0 +1,110 @@
+/*
+ * Persistent console log: a 4 MiB ring in the console layer is flushed once a second
+ * to the tail of the root device, so a boot log survives a panic and can be pulled
+ * from the host instead of photographed. Layout at the tail:
+ *
+ *   [4 KiB header: "NUWALOG" | u32 version | u32 ring_bytes | u64 total | u64 flushed]
+ *   [ring_bytes of ring, oldest data wrapping]
+ */
+#include <sys/param.h>
+#include <sys/buf.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/proc.h>
+#include <sys/kauth.h>
+#include <sys/malloc.h>
+#include <sys/systm.h>
+#include <mach/mach_types.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <libkern/libkern.h>
+
+#define CONSOLE_LOG_BYTES   (4u << 20)
+#define CONSOLE_LOG_HEADER  4096
+#define CONSOLE_LOG_BLOCK   (64 * 1024)
+#define CONSOLE_LOG_MAGIC   "NUWALOG"
+/* The OS window of the SHNGROOT image: 1 MiB manifest + 5.25 GiB OS window. */
+/* The root device here is the 5,635,081,728-byte OS window of the SHNGROOT image. */
+#define CONSOLE_LOG_DEVICE  5635081728ULL
+#define CONSOLE_LOG_TAIL    (CONSOLE_LOG_DEVICE - CONSOLE_LOG_BYTES - CONSOLE_LOG_HEADER)
+
+extern char native_console_log_ring[];
+extern volatile uint64_t native_console_log_total;
+extern int bdevvp(dev_t dev, vnode_t *vpp);
+extern void IOSleep(int millis);
+
+static uint64_t native_console_log_flushed;
+
+void native_console_log_start(void);
+
+static int
+native_console_log_write(vnode_t devvp, off_t offset, caddr_t data, size_t size)
+{
+	daddr64_t blkno = (daddr64_t)(offset / PAGE_SIZE);
+	buf_t bp = buf_getblk(devvp, blkno, (int)size, 0, 0, BLK_WRITE);
+	if (bp == NULL) {
+		return EIO;
+	}
+	memcpy(buf_dataptr(bp), data, size);
+	buf_strategy(devvp, bp);
+	buf_brelse(bp);
+	return 0;
+}
+
+static void
+native_console_log_thread(void *unused, wait_result_t wait_result)
+{
+	vnode_t devvp = NULLVP;
+	char *block;
+	(void)unused;
+	(void)wait_result;
+
+	if (bdevvp(rootdev, &devvp) != 0) {
+		printf("native-console-log: cannot open the root device\n");
+		return;
+	}
+	block = (char *)_MALLOC(CONSOLE_LOG_BLOCK, M_TEMP, M_WAITOK);
+	if (block == NULL) {
+		return;
+	}
+	for (;;) {
+		uint64_t total;
+		IOSleep(1000);
+		total = native_console_log_total;
+		if (total == native_console_log_flushed) {
+			continue;
+		}
+		{
+			char *header = (char *)_MALLOC(CONSOLE_LOG_HEADER, M_TEMP, M_WAITOK);
+			uint32_t version = 1;
+			uint32_t ring = CONSOLE_LOG_BYTES;
+			if (header != NULL) {
+				memset(header, 0, CONSOLE_LOG_HEADER);
+				memcpy(header, CONSOLE_LOG_MAGIC, 7);
+				memcpy(header + 8, &version, 4);
+				memcpy(header + 12, &ring, 4);
+				memcpy(header + 16, &total, 8);
+				memcpy(header + 24, &native_console_log_flushed, 8);
+				native_console_log_write(devvp, CONSOLE_LOG_TAIL, header, CONSOLE_LOG_HEADER);
+				_FREE(header, M_TEMP);
+			}
+		}
+		for (uint32_t offset = 0; offset < CONSOLE_LOG_BYTES; offset += CONSOLE_LOG_BLOCK) {
+			for (uint32_t index = 0; index < CONSOLE_LOG_BLOCK; index++) {
+				block[index] = native_console_log_ring[(offset + index) & (CONSOLE_LOG_BYTES - 1)];
+			}
+			native_console_log_write(devvp, (off_t)(CONSOLE_LOG_TAIL + CONSOLE_LOG_HEADER + offset),
+			    block, CONSOLE_LOG_BLOCK);
+		}
+		native_console_log_flushed = total;
+	}
+}
+
+void
+native_console_log_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(native_console_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
index 715c545..8560d05 100644
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -277,12 +277,28 @@ _cnputc(char c, bool poll)
  *             waiting for an interrupt when the hardware device isn't ready
  * @param size The number of characters to print to the console.
  */
+/* Persistent console log ring shared with the bsd-side flush thread. */
+#define NATIVE_CONSOLE_LOG_BYTES (4u << 20)
+
+char native_console_log_ring[NATIVE_CONSOLE_LOG_BYTES];
+volatile uint64_t native_console_log_total;
+
+void
+native_console_log_capture(const char *data, int size)
+{
+	uint64_t total = __atomic_fetch_add(&native_console_log_total, (uint64_t)size, __ATOMIC_RELAXED);
+	for (int index = 0; index < size; index++) {
+		native_console_log_ring[(uint32_t)(total + index) & (NATIVE_CONSOLE_LOG_BYTES - 1)] = data[index];
+	}
+}
+
 static inline void
 _cnputs(char *c, int size, bool poll)
 {
 	if (disableConsoleOutput) {
 		return;
 	}
+	native_console_log_capture(c, size);
 
 	assert(c != NULL);
 
